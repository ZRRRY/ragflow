# -----------------------------------------------------------------------------
# 安全警告：请勿使用默认密码部署
# 非本地部署时，请将所有密码（ELASTIC_PASSWORD、
# MYSQL_PASSWORD、MINIO_PASSWORD 等）修改为强度高且唯一的值。
# 可使用以下命令生成随机字符串：openssl rand -hex 32
# -----------------------------------------------------------------------------

# ------------------------------
# 用于在启动时指定向量数据库类型的 Docker 环境变量
#（根据向量数据库类型，将使用对应的 Docker
# compose profile）
# ------------------------------
# 要使用的文档引擎类型。
# 可用选项：
# - `elasticsearch`（默认）
# - `infinity`（https://github.com/infiniflow/infinity）
# - `oceanbase`（https://github.com/oceanbase/oceanbase）
# - `opensearch`（https://github.com/opensearch-project/OpenSearch）
# - `seekdb`（https://github.com/oceanbase/seekdb）
DOC_ENGINE=${DOC_ENGINE:-opensearch}

# deepdoc 推理运行的设备。
# 可用级别：
# - `cpu`（默认）
# - `gpu`
DEVICE=${DEVICE:-cpu}

COMPOSE_PROFILES=${DOC_ENGINE},${DEVICE}

# Elasticsearch 的版本。
STACK_VERSION=${STACK_VERSION:-8.11.3}

# Elasticsearch 服务暴露的主机名
ES_HOST=es01

# 用于向宿主机暴露 Elasticsearch 服务的端口，
# 允许从外部访问运行在 Docker 容器内的服务。
ES_PORT=1200

# Elasticsearch 的密码。
# 警告：生产环境请修改此密码！
ELASTIC_PASSWORD=infini_rag_flow

# OpenSearch 服务暴露的主机名，请设置为与 elasticsearch 不同
OS_PORT=1201

# OpenSearch 服务暴露的主机名
OS_HOST=opensearch01

# OpenSearch 的密码。
# 至少包含一个大写字母、一个小写字母、一个数字和一个特殊字符
OPENSEARCH_PASSWORD=infini_rag_flow_OS_01

# 用于向宿主机暴露 Kibana 服务的端口，
# 允许从外部访问运行在 Docker 容器内的服务。
# 要启用 Kibana，你需要：
# 1. 确保 COMPOSE_PROFILES 包含 kibana，例如：COMPOSE_PROFILES=${COMPOSE_PROFILES},kibana
# 2. 在 docker-compose-base.yml 中注释或删除 es 服务的以下配置：xpack.security.enabled、xpack.security.http.ssl.enabled、xpack.security.transport.ssl.enabled（详见：https://www.elastic.co/docs/deploy-manage/security/self-auto-setup#stack-existing-settings-detected）
# 3. 将 conf/service_config.yaml 或 docker/service_conf.yaml.template 中的 es.hosts 调整为 'https://localhost:1200'
# 4. 启动成功后，在 es 容器内执行命令生成 kibana token：`bin/elasticsearch-create-enrollment-token -s kibana`，之后即可正常使用 Kibana
KIBANA_PORT=6601

# 特定 Docker 容器运行时可使用的最大内存字节数。
# 请根据宿主机的可用内存进行调整。
MEM_LIMIT=8073741824

# Infinity 服务暴露的主机名
INFINITY_HOST=infinity

# 向宿主机暴露 Infinity API 的端口
INFINITY_THRIFT_PORT=23817
INFINITY_HTTP_PORT=23820
INFINITY_PSQL_PORT=5432

# OceanBase 服务暴露的主机名
OCEANBASE_HOST=oceanbase
# 用于暴露 OceanBase 服务的端口
OCEANBASE_PORT=2881
# OceanBase 的用户名
OCEANBASE_USER=root@ragflow
# OceanBase 的密码
OCEANBASE_PASSWORD=infini_rag_flow
# 要使用的 OceanBase 文档数据库
OCEANBASE_DOC_DBNAME=ragflow_doc

# OceanBase 容器配置
OB_CLUSTER_NAME=${OB_CLUSTER_NAME:-ragflow}
OB_TENANT_NAME=${OB_TENANT_NAME:-ragflow}
OB_SYS_PASSWORD=${OCEANBASE_PASSWORD:-infini_rag_flow}
OB_TENANT_PASSWORD=${OCEANBASE_PASSWORD:-infini_rag_flow}
OB_MEMORY_LIMIT=${OB_MEMORY_LIMIT:-10G}
OB_SYSTEM_MEMORY=${OB_SYSTEM_MEMORY:-2G}
OB_DATAFILE_SIZE=${OB_DATAFILE_SIZE:-20G}
OB_LOG_DISK_SIZE=${OB_LOG_DISK_SIZE:-20G}

# SeekDB 服务暴露的主机名
SEEKDB_HOST=seekdb
# 用于暴露 SeekDB 服务的端口
SEEKDB_PORT=2881
# SeekDB 的用户名
SEEKDB_USER=root
# SeekDB 的密码
SEEKDB_PASSWORD=infini_rag_flow
# 要使用的 SeekDB 文档数据库
SEEKDB_DOC_DBNAME=ragflow_doc
# SeekDB 内存限制
SEEKDB_MEMORY_LIMIT=2G

# MySQL 的密码。
# 警告：生产环境请修改此密码！
MYSQL_PASSWORD=infini_rag_flow
# MySQL 服务暴露的主机名
MYSQL_HOST=mysql
# 要使用的 MySQL 数据库
MYSQL_DBNAME=rag_flow
# 用于从 RAGFlow 容器连接 MySQL 的端口。
# 如果使用外部 MySQL，请修改此项。
MYSQL_PORT=3306
# 用于向宿主机暴露 MySQL 服务的端口，
# 允许从外部访问运行在 Docker 容器内的 MySQL 数据库。
EXPOSE_MYSQL_PORT=3306
# 发送到 MySQL 服务器的通信数据包的最大大小
MYSQL_MAX_PACKET=1073741824

# MinIO 服务暴露的主机名
MINIO_HOST=minio
# 用于向宿主机暴露 MinIO 控制台界面的端口，
# 允许从外部访问运行在 Docker 容器内的 Web 控制台。
MINIO_CONSOLE_PORT=9001
# 用于向宿主机暴露 MinIO API 服务的端口，
# 允许从外部访问运行在 Docker 容器内的 MinIO 对象存储服务。
MINIO_PORT=9000
# MinIO 的用户名。
# 修改后，必须同步更新 service_conf.yaml 中的 `minio.user` 配置项。
MINIO_USER=rag_flow
# MinIO 的密码。
# 修改后，必须同步更新 service_conf.yaml 中的 `minio.password` 配置项。
MINIO_PASSWORD=infini_rag_flow

# Redis 服务暴露的主机名
REDIS_HOST=redis
# 用于向宿主机暴露 Redis 服务的端口，
# 允许从外部访问运行在 Docker 容器内的 Redis 服务。
REDIS_PORT=6379
# Redis 的密码。
REDIS_PASSWORD=infini_rag_flow

# 用于向宿主机暴露 RAGFlow HTTP API 服务的端口，
# 允许从外部访问运行在 Docker 容器内的服务。
SVR_WEB_HTTP_PORT=8088
SVR_WEB_HTTPS_PORT=443
SVR_HTTP_PORT=9380
ADMIN_SVR_HTTP_PORT=9381
SVR_MCP_PORT=9382
GO_HTTP_PORT=9384
GO_ADMIN_PORT=9383

# API_PROXY_SCHEME=hybrid # Go 与 Python 混合部署模式
API_PROXY_SCHEME=python # 使用纯 Python 服务器部署

# 要下载的 RAGFlow Docker 镜像。v0.22 及以上版本不包含 embedding 模型。
RAGFLOW_IMAGE=infiniflow/ragflow:v0.25.6

# 如果你无法下载 RAGFlow Docker 镜像：
# RAGFLOW_IMAGE=swr.cn-north-4.myhuaweicloud.com/infiniflow/ragflow:v0.25.6
# RAGFLOW_IMAGE=registry.cn-hangzhou.aliyuncs.com/infiniflow/ragflow:v0.25.6
#
# - 对于 `nightly` 版本，取消以下任意一行的注释：
# RAGFLOW_IMAGE=swr.cn-north-4.myhuaweicloud.com/infiniflow/ragflow:nightly
# RAGFLOW_IMAGE=registry.cn-hangzhou.aliyuncs.com/infiniflow/ragflow:nightly

# Embedding 服务的镜像、模型和端口。
# 重要提示：要启用 embedding 服务，你需要取消以下两行中某一行的注释：
# COMPOSE_PROFILES=${COMPOSE_PROFILES},tei-cpu
# COMPOSE_PROFILES=${COMPOSE_PROFILES},tei-gpu

# Embedding 服务镜像：
TEI_IMAGE_CPU=infiniflow/text-embeddings-inference:cpu-1.8
TEI_IMAGE_GPU=infiniflow/text-embeddings-inference:1.8

# Embedding 服务模型：
# 可用选项：
# - `Qwen/Qwen3-Embedding-0.6B`（默认，加载需要 25GB RAM/vRAM）
# - `BAAI/bge-m3`（加载需要 21GB RAM/vRAM）
# - `BAAI/bge-small-en-v1.5`（加载需要 1.2GB RAM/vRAM）
TEI_MODEL=${TEI_MODEL:-Qwen/Qwen3-Embedding-0.6B}

# Embedding 服务端口：
TEI_HOST=tei
# 用于向宿主机暴露 TEI 服务的端口，
# 允许从外部访问运行在 Docker 容器内的服务。
TEI_PORT=6380

# 本地时区。
TZ=Asia/Shanghai

# 如果你访问 huggingface.co 受限，请取消以下行的注释：
# HF_ENDPOINT=https://hf-mirror.com

# MacOS 优化选项
# 如果你的操作系统是 MacOS，请取消以下行的注释：
# MACOS=1

# 每次上传到数据集或 RAGFlow 文件系统的文件大小限制（字节）。
# 要修改 1GB 的文件大小限制，请取消下面一行的注释并按需更新。
# MAX_CONTENT_LENGTH=1073741824
# 修改后，请确保同步更新 nginx/nginx.conf 中的 `client_max_body_size`。
# 注意：`MAX_CONTENT_LENGTH` 和 `client_max_body_size` 均不限制上传到 agent 的文件大小。
# 详见 https://ragflow.io/docs/dev/begin_component。

# 控制每批处理多少文档。
# 如果未显式设置 DOC_BULK_SIZE，则默认为 4。
DOC_BULK_SIZE=${DOC_BULK_SIZE:-4}

# 定义生成 embedding 时每批处理的条目数。
# 如果环境中未设置 EMBEDDING_BATCH_SIZE，则默认为 16。
EMBEDDING_BATCH_SIZE=${EMBEDDING_BATCH_SIZE:-16}

# RAGFlow 自身及其引入依赖包的日志级别。
# 可用级别：
# - `DEBUG`
# - `INFO`（默认）
# - `WARNING`
# - `ERROR`
# 例如，以下行可将 `ragflow.es_conn` 的日志级别设置为 `DEBUG`：
# LOG_LEVELS=ragflow.es_conn=DEBUG

# 阿里云 OSS 配置
# STORAGE_IMPL=OSS
# ACCESS_KEY=xxx
# SECRET_KEY=eee
# ENDPOINT=http://oss-cn-hangzhou.aliyuncs.com
# REGION=cn-hangzhou
# BUCKET=ragflow65536
# 

# 用户注册开关：
# - 启用注册：1
# - 禁用注册：0
REGISTER_ENABLED=1

# -----------------------------------------------------------------------------
# 沙箱
# -----------------------------------------------------------------------------
# Sandbox 提供方类型和运行设置请在 Admin > Sandbox
# Settings 中配置。

# 启用 sandbox 支持。
# SANDBOX_ENABLED=1
# COMPOSE_PROFILES=${COMPOSE_PROFILES},sandbox

# 共享 sandbox 设置
# 用于存储 sandbox 生成产物的 MinIO bucket 名称。
# SANDBOX_ARTIFACT_BUCKET=sandbox-artifacts

# sandbox 产物自动删除前的保留天数。
# SANDBOX_ARTIFACT_EXPIRE_DAYS=7

# 自托管部署默认值
# 这些值由 `sandbox` compose profile 使用，并会在 Admin 中作为
# 自托管提供方的部署默认值显示。
#
# 运行前请先拉取所需的基础镜像：
#   docker pull infiniflow/sandbox-base-nodejs:latest
#   docker pull infiniflow/sandbox-base-python:latest
# 默认运行时镜像包含：
# - Node.js 基础镜像：axios
# - Python 基础镜像：requests、numpy、pandas
# SANDBOX_EXECUTOR_MANAGER_IMAGE=${SANDBOX_EXECUTOR_MANAGER_IMAGE:-infiniflow/sandbox-executor-manager:latest}
# SANDBOX_EXECUTOR_MANAGER_POOL_SIZE=${SANDBOX_EXECUTOR_MANAGER_POOL_SIZE:-3}
# SANDBOX_BASE_PYTHON_IMAGE=${SANDBOX_BASE_PYTHON_IMAGE:-infiniflow/sandbox-base-python:latest}
# SANDBOX_BASE_NODEJS_IMAGE=${SANDBOX_BASE_NODEJS_IMAGE:-infiniflow/sandbox-base-nodejs:latest}
# SANDBOX_EXECUTOR_MANAGER_PORT=${SANDBOX_EXECUTOR_MANAGER_PORT:-9385}
# SANDBOX_ENABLE_SECCOMP=false
# SANDBOX_MAX_MEMORY=256m # 单位：b、k、m、g
# SANDBOX_TIMEOUT=10s # 单位：s、m、1m30s

# -----------------------------------------------------------------------------
# Sandbox 结束
# -----------------------------------------------------------------------------

# 启用 DocLing
USE_DOCLING=false

# 启用 Mineru
# 取消这些行的注释后，系统会尽可能自动将 MinerU 添加到模型提供方中。
# 详见 https://ragflow.io/docs/faq#how-to-use-mineru-to-parse-pdf-documents。
# MINERU_DELETE_OUTPUT=0   # 保留输出目录
# MINERU_BACKEND=pipeline  # 或你偏好的其他后端

# pptx 支持
DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1

# 加密工具
# RAGFLOW_CRYPTO_ENABLED=true
# RAGFLOW_CRYPTO_ALGORITHM=aes-256-cbc # 可选 aes-256-cbc、aes-128-cbc、sm4-cbc 之一
# RAGFLOW_CRYPTO_KEY=ragflow-crypto-key


# 用于 ThreadPoolExecutor
THREAD_POOL_MAX_WORKERS=128

# 禁用 SSO 登录表单的选项
DISABLE_PASSWORD_LOGIN=false

# ------------------------------------------------------------------------------
# GraphRAG 增量重构功能开关 (P1-P5)
# ------------------------------------------------------------------------------
# 说明：本节大多数变量为[全局]开关，由 rag/graphrag/config.py 或
# rag/graphrag/general/index.py 在 Python 导入时一次性读取。
#
# 少量变量标记为[KB 默认值]，它们在运行时不会从环境变量读取，
# 仅用于说明新建知识库 parser_config 时使用的硬编码默认值
#（参见 api/utils/api_utils.py 和 api/utils/validation_utils.py）。
# 若要修改已有 KB 的该值，请直接更新其 parser_config。
#
# 修改后必须重启容器才能生效（Python 在导入时读取，运行时不会重新加载）
#
# P1 - 存储解耦：将实体/关系分片存储到 doc store，替代单一 JSON 大文件
#   1=启用  0=禁用（回退到 legacy monolithic JSON 模式）
USE_INCREMENTAL_GRAPH=1
#
# P2 - 增量合并：只加载受影响的已有节点/边，不加载全图；跳过全局 PageRank
USE_INCREMENTAL_MERGE=1
# P2 - CAS 冲突最大重试次数（全局，默认 10）
MERGE_CAS_MAX_RETRIES=10
#
# P3 - 增量消解：按实体类型构建局部图进行消解，避免全图加载。
#   增量路径已改用 OpenSearch KNN 索引召回候选（不再加载全类型实体到内存）。
#   0=禁用（回退到全量消解，会加载全图并走内存 ANN/O(n²)）
USE_INCREMENTAL_RESOLUTION=1
#
# P3.1 - 实体消解候选召回方式：
#   1=OpenSearch KNN（推荐，利用已索引的 q_vec，无需重新 embedding）
#   0=字符级过滤（仅 is_similarity_str，不依赖向量索引，适合小 KB 或索引未就绪时）
USE_KNN_FOR_RESOLUTION=1
#
#   最近邻数量（默认 20）。KNN 模式下对应 OpenSearch knn.k。
ENTITY_RESOLUTION_TOP_K=30
#   相似度阈值（默认 0.7）。KNN 模式下对应 OpenSearch min_score（cosine）。
#   低于此值的邻居不进入候选。
ENTITY_RESOLUTION_SIM_THRESHOLD=0.7
#   KNN 查询并发数（默认 8）。控制同时发往 OpenSearch 的 KNN 请求数，
#   大 KB / 高维向量场景可适当降低以避免 OpenSearch 过载。
ENTITY_RESOLUTION_KNN_CONCURRENCY=1
#   消解阶段每批处理的实体数量（全局，默认 100）
RESOLUTION_BATCH_SIZE=100
#   消解阶段最大并发任务数（全局，默认 5）
RESOLUTION_MAX_CONCURRENT_TASKS=5
#
# P4 - 异步社区：delta 图自动检测，从索引加载完整图后执行 Leiden
USE_ASYNC_COMMUNITY=1
# P4.4 - 批量实体/边摘要（全局）
#   1=启用  0=禁用（默认；每个实体/边单独调用 LLM）
USE_BATCHED_SUMMARIZATION=0
#   每批摘要处理的实体/边数量（全局，默认 20）
ENTITY_SUMMARY_BATCH_SIZE=20
#
# P5-T1 - KG 任务并发上限：控制同时运行的 GraphRAG pipeline 数量（每个 worker 进程）
MAX_CONCURRENT_KG_TASKS=2
#
# P5-T2 - 自适应限流器：根据 LLM 限流/CAS 冲突/ES 延迟自动调整并发
#   1=启用  0=禁用（使用静态 Semaphore）
USE_ADAPTIVE_LIMITER=1
#
# P5-T2 - 自适应限流器参数（仅当 USE_ADAPTIVE_LIMITER=1 时生效）
#   MIN_CONCURRENT_KG_TASKS: 并发下限，最低不会低于此值
#   ADAPTIVE_INTERVAL: 调整周期（秒），默认 30 秒评估一次
#   ADAPTIVE_DEGRADE_THRESHOLD: 窗口内 bad 事件数达到此值则降级（limit -= 1）
#   ADAPTIVE_INCREASE_THRESHOLD: 窗口内 good 事件数达到此值且无 bad 则升级（limit += 1）
#   ES_SLOW_THRESHOLD_MS: ES/Infinity 写入耗时超过此值（毫秒）记为 es_slow 事件
MIN_CONCURRENT_KG_TASKS=1
ADAPTIVE_INTERVAL=20
ADAPTIVE_DEGRADE_THRESHOLD=1
ADAPTIVE_INCREASE_THRESHOLD=10
ES_SLOW_THRESHOLD_MS=3000
#
# P5-T4 - 启动时卡住任务自动修复（reconcile）
#   当 task_executor 进程因 SIGKILL / OOM / 网络瞬断崩溃时，可能出现 OS 里
#   实体/关系数据已写完，但 MySQL task 表 progress 永远卡在 (0,1) 的情况。
#   本开关控制 worker 启动时是否自动扫描并修复这类"假死"任务。
#   1=启用  0=禁用（默认禁用，需要时手动用 docker/finisher/finish_stuck_graphrag.py）
RECONCILE_STUCK_ON_BOOT=0
#   grace 时间（分钟）：最近更新过的任务不算 stuck，避免误判正在运行的任务
STUCK_TASK_GRACE_MINUTES=30
#   OS 中至少要有这么多 entity/relation 才认为是"实质完成"，防止空数据误标
STUCK_TASK_MIN_NODES=3
STUCK_TASK_MIN_EDGES=3
#
# P5-T5 - 任务心跳锁（reconcile v2 的存活信标）
#   正在运行的 GraphRAG 任务会定期写 Redis 心跳键；reconcile 扫描时若发现
#   心跳 TTL 仍有效，则判定为"真在跑"而跳过，避免误修复正常任务。
HEARTBEAT_INTERVAL=30
HEARTBEAT_TTL=90
#
# ------------------------------------------------------------------------------
# Phase 0 配置加固 - 减少 OpenSearch 写放大 / 避免大 KB 卡死
# ------------------------------------------------------------------------------
# GRAPHRAG_INSERT_BULK_SIZE: 写入 doc store 的批量大小（默认 64）。OpenSearch
#   上调大到 128 可减少 50% 往返请求数，但单批内存/超时风险略增
GRAPHRAG_INSERT_BULK_SIZE=128
#
# GRAPHRAG_INSERT_CONCURRENCY: 同时在途写入的批次数（默认 2）。OpenSearch
#   上 4 是相对安全的并发
GRAPHRAG_INSERT_CONCURRENCY=4
#
# build_subgraph_timeout_per_chunk_seconds: [KB 默认值] 单 chunk LLM 抽取超时
#   （默认 300）。给予 LLM 较充裕的抽取时间，降低单 chunk 超时概率。
#   不是全局环境变量；仅作为新建 KB parser_config 的默认值。
build_subgraph_timeout_per_chunk_seconds=300
#
# build_subgraph_min_timeout_seconds: [KB 默认值] 单个文档的最低 build_subgraph 超时
#   （默认 600）。
#   不是全局环境变量；仅作为新建 KB parser_config 的默认值。
build_subgraph_min_timeout_seconds=600
#
# KG_MAX_SAFE_RESUME_NODES: 纯 resume 路径允许的最大 node 数（默认 5000）。
#   超过则拒绝并要求用户重新走增量提交，避免 O(n^2) resolution
KG_MAX_SAFE_RESUME_NODES=5000
#
# P5-T3 - 异步后处理队列：将 resolution/community 阶段丢入 Redis Stream 异步消费
#   1=启用  0=禁用（同步执行，与之前行为一致）
USE_ASYNC_KG_PHASES=0
#
# P5-T3 - 后处理队列名称（Redis Stream key）
KG_POSTPROCESS_QUEUE=graphrag:postprocess
#
# 启用顺序建议：P1 -> P2 -> P3 -> P4 -> P5，按阶段逐步验证
# 回退方法：将所有 USE_* 设为 0 并重启容器，即回到 legacy 行为
# ------------------------------------------------------------------------------

# P6 - 重跑控制（全局，由 rag/graphrag/config.py 读取）
#   1=保留/复用之前的结果  0=清空并重新运行
GRAPHRAG_KEEP_SUBGRAPH=1
GRAPHRAG_KEEP_MERGE=0
GRAPHRAG_KEEP_RESOLUTION=0
#
# 每个 GraphRAG 任务并行处理的最大文档数（全局，由
# rag/graphrag/general/index.py 读取，默认 8）
GRAPHRAG_MAX_PARALLEL_DOCS=16