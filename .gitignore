# ============================================================
# RAGFlow .gitignore
# ============================================================

# --- 操作系统 ---
.DS_Store

# --- Python ---
__pycache__/
.venv
venv/
api/flask_session
/flask_session
*huqie.txt
.hypothesis
ragflow_cli.egg-info
ragflow.egg-info/
sdk/python/ragflow.egg-info/
sdk/python/ragflow_sdk.egg-info/
sdk/python/build/
sdk/python/dist/

# --- Rust / Cargo ---
# 由 Cargo 生成
# 包含编译后的文件与可执行文件
debug/
target/
/target
# 如果创建可执行文件，请从 gitignore 中移除 Cargo.lock；如果是库则保留
# 更多信息：https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock
# rustfmt 生成的备份文件
**/*.rs.bk
# MSVC Windows 版本的 rustc 生成这些文件，用于存储调试信息
*.pdb
*.trie

# --- Node.js / 前端 ---
# 以下内容由 gitignore.nvim 生成（Node）

# 依赖目录
node_modules/
jspm_packages/
web_modules/

# 编译后的二进制扩展
build/Release

# 各种前端构建输出
dist
.next
out
.nuxt
.svelte-kit
.webpack/
.serverless/
.fusebox/
.dynamodb/
.parcel-cache
.cache
.cache/
.temp
.vuepress/dist
.docusaurus

# 测试覆盖率
lib-cov
coverage
*.lcov
.nyc_output

# 旧式前端工具
.grunt
bower_components
.lock-wscript

# TypeScript 缓存
*.tsbuildinfo

# 包管理器缓存与锁文件
.npm
.eslintcache
.stylelintcache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Yarn 相关
.yarn-integrity
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# 'npm pack' 的输出
*.tgz

# 可选的 REPL 历史
.node_repl_history

# TernJS 端口文件
.tern-port

# --- Go 服务 ---
# Go 服务构建输出
bin/*
!bin/.gitkeep

# --- C++ ---
# C++ 构建目录
internal/cpp/build/
internal/cpp/cmake-build-release/
internal/cpp/cmake-build-debug/

# --- 日志 / 运行时 ---
logs
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*
pids
*.pid
*.seed
*.pid.lock
# Node.js 诊断报告 (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
.lh/

# --- 环境变量 / 密钥 ---
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# --- IDE / 编辑器 ---
.idea/
.vscode/
# 用于测试 VSCode 扩展的 VSCode 版本存储目录
.vscode-test
.cursor/settings.json
.trae/

# --- Hash 命名的临时文件 ---
# 排除类似 hash 命名的临时文件（如 9b5ad71b2ce5302211f9c61530b329a4922fc6a4）
*[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]*

# --- 下载的依赖（大文件/二进制） ---
libssl*.deb
tika-server*.jar*
cl100k_base.tiktoken
chrome*
huggingface.co/
nltk_data/
uv-x86_64*.tar.gz
uv-aarch64*.tar.gz
uv-aarch64-unknown-linux-gnu.tar.gz

# --- Docker / 数据目录 ---
docker/ragflow-logs/
docker/data
# OceanBase 数据与配置
docker/oceanbase/conf
docker/oceanbase/data
# SeekDB 数据与配置
docker/seekdb

# --- 项目相关构建产物 ---
rag/res/deepdoc
hudet/
cv/
layout_app.py
# 默认备份目录
backup
# 不要包含在 PR 中（本地开发/构建产物）
docker/launch_backend_service_windows.sh
# 仅忽略根目录的 Markdown 文件
/*.md

# --- 本地开发（不要包含在 PR 中） ---
# 忽略本地的 agent 和 playwright-mcp 目录
.agents/
.playwright-mcp/
.claude/settings.local.json
# 忽略本地的 mydocs 目录
/mydocs

#远程检索测试脚本（本地用，不入仓库）
/test_retrieval_remote.py
